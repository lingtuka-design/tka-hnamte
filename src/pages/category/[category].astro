---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCategories } from '../../lib/data';

export async function getStaticPaths() {
  const cats = await getCategories();
  const slugs = new Set<string>();
  for (const c of cats) {
    if (c && c.slug) slugs.add(c.slug);
  }
  // Guarantee the main Article category page always builds, even though the
  // post list itself is rendered client-side from the KV-backed /api/posts.
  slugs.add('article');
  return Array.from(slugs).map((slug) => ({ params: { category: slug } }));
}

const categories = await getCategories();
const { category } = Astro.params;
const matchedCat = categories.find(c => c.slug === category || c.name.toLowerCase() === category?.toLowerCase());
const categoryName = matchedCat ? matchedCat.name : category || 'Category';
---

<BaseLayout title={`Category: ${categoryName} - ṬKA Hnamte`}>
  <div class="main-layout">
    <section class="posts-feed">
      <div style="margin-bottom: 25px; padding-bottom: 12px; border-bottom: 2px solid var(--accent-blue);">
        <h1 style="font-size: 1.5rem; color: var(--text-heading); font-weight: 700; text-transform: uppercase;">
          Category: {categoryName}
        </h1>
        <p style="font-size: 0.9rem; color: var(--text-muted);">Showing all posts filed under {categoryName}</p>
      </div>

      <div id="categoryPostsContainer">
        <div id="categoryLoading" style="padding: 60px 0; text-align: center; color: var(--text-muted);">
          <p>Loading posts...</p>
        </div>
      </div>
    </section>

    <Sidebar />
  </div>
</BaseLayout>

<script>
  const categoryParam = window.location.pathname.split('/').filter(Boolean).pop() || '';

  function stripHtml(html: any): string {
    if (!html) return '';
    const d = document.createElement('div');
    d.innerHTML = String(html).replace(/<script[\s\S]*?<\/script>/gi, '');
    return d.textContent || '';
  }

  function postCardHTML(post: any) {
    return `
      <article class="post-card">
        <div class="post-header">
          <div class="date-badge">
            <span class="day">${post.day || '01'}</span>
            <span class="month">${post.month || 'Aug'}</span>
          </div>
          <div class="post-title-link">
            <h2 class="post-title">
              <a href="/post/read?slug=${post.slug}">${post.title}</a>
            </h2>
          </div>
        </div>

        <div class="post-image-wrap">
          <a href="/post/read?slug=${post.slug}">
            <img src="${post.featuredImage || 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1200&q=80'}" alt="${post.title}" loading="lazy" />
          </a>
        </div>

        <p class="post-excerpt">${post.excerpt || stripHtml(post.content) || ''}</p>

        <div class="post-footer">
          <a href="/post/read?slug=${post.slug}" class="read-more">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Read more
          </a>
          <span class="comments-count">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
            ${post.commentsCount || 0} Comments
          </span>
        </div>
      </article>
    `;
  }

  function matchesCategory(post: any): boolean {
    if (!post) return false;
    const slugMatch = post.categorySlug === categoryParam;
    const nameMatch = String(post.category || '').toLowerCase() === categoryParam.toLowerCase();
    return slugMatch || nameMatch;
  }

  function sortByDateDesc(posts: any[]): any[] {
    return [...posts].sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')));
  }

  function mergePosts(cloud: any[], local: any[]): any[] {
    const map = new Map();
    for (const list of [cloud, local]) {
      if (!Array.isArray(list)) continue;
      for (const p of list) {
        if (p && p.id && !map.has(p.id)) map.set(p.id, p);
      }
    }
    return Array.from(map.values());
  }

  const container = document.getElementById('categoryPostsContainer');

  function renderCategory(posts: any[]) {
    if (!container) return;
    const filtered = posts.filter(matchesCategory);
    if (filtered.length > 0) {
      container.innerHTML = sortByDateDesc(filtered).map((post: any) => postCardHTML(post)).join('');
    } else {
      container.innerHTML = '<div style="padding: 40px 0; text-align: center;"><p>No posts found in this category yet.</p></div>';
    }
  }

  async function initCategory() {
    if (!container) return;

    // Paint instantly from the cached copy.
    let localPosts = [];
    const stored = localStorage.getItem('tka_posts');
    if (stored) {
      try { localPosts = JSON.parse(stored); } catch (e) {}
    }
    if (localPosts.length > 0) renderCategory(localPosts);

    // Sync from the KV-backed cloud database (authoritative).
    let cloudPosts = [];
    try {
      const res = await fetch('/api/posts');
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.posts)) cloudPosts = data.posts;
      }
    } catch (err) {}

    const allPosts = mergePosts(cloudPosts, localPosts);
    localStorage.setItem('tka_posts', JSON.stringify(allPosts));
    renderCategory(allPosts);
  }

  initCategory();
</script>
