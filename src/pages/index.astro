---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPosts, getSiteData } from '../lib/data';

const posts = await getPosts();
const site = await getSiteData();
---

<BaseLayout title={`${site.title} - ${site.tagline}`} description={site.bio}>
  <div class="main-layout">
    <section class="posts-feed" id="postsFeedContainer">
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} />)
      ) : (
        <div style="padding: 40px 0; text-align: center;">
          <p>No blog posts published yet.</p>
        </div>
      )}
    </section>

    <Sidebar />
  </div>
</BaseLayout>

<script>
  // Purge old sample posts from browser cache if present
  let storedPosts = localStorage.getItem('tka_posts');
  if (storedPosts && (storedPosts.includes('tourist-destination') || storedPosts.includes('post-1') || storedPosts.includes('post-101') || storedPosts.includes('unsplash.com') || storedPosts.includes('hnathawh-zak-suh'))) {
    localStorage.removeItem('tka_posts');
    storedPosts = null;
  }

  if (storedPosts) {
    try {
      const posts = JSON.parse(storedPosts);
      const feedContainer = document.getElementById('postsFeedContainer');

      if (feedContainer && posts.length > 0) {
        feedContainer.innerHTML = posts.map((post: any) => `
          <article class="post-card">
            <div class="post-header">
              <div class="date-badge">
                <span class="day">${post.day}</span>
                <span class="month">${post.month}</span>
              </div>
              <div class="post-title-link">
                <h2 class="post-title">
                  <a href="/post/${post.slug}">${post.title}</a>
                </h2>
              </div>
            </div>

            <div class="post-image-wrap">
              <a href="/post/${post.slug}">
                <img src="${post.featuredImage}" alt="${post.title}" loading="lazy" />
              </a>
            </div>

            <p class="post-excerpt">${post.excerpt}</p>

            <div class="post-footer">
              <a href="/post/${post.slug}" class="read-more">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Read more
              </a>
              <span class="comments-count">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
                ${post.commentsCount || 0} Comments
              </span>
            </div>
          </article>
        `).join('');
      }
    } catch (e) {}
  }
</script>
