---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPosts, getSiteData } from '../lib/data';

const posts = await getPosts();
const site = await getSiteData();
---

<BaseLayout title={`${site.title} - ${site.tagline}`} description={site.bio}>
  <div class="main-layout">
    <section class="posts-feed" id="postsFeedContainer">
      <div id="feedLoading" style="padding: 60px 0; text-align: center; color: var(--text-muted);">
        <p>Loading posts...</p>
      </div>
    </section>

    <Sidebar />
  </div>

  <script type="application/json" id="ssrPosts" is:inline>{JSON.stringify(posts)}</script>
</BaseLayout>

<script>
  function postCardHTML(post: any) {
    return `
      <article class="post-card">
        <div class="post-header">
          <div class="date-badge">
            <span class="day">${post.day || '01'}</span>
            <span class="month">${post.month || 'Aug'}</span>
          </div>
          <div class="post-title-link">
            <h2 class="post-title">
              <a href="/post/read?slug=${post.slug}">${post.title}</a>
            </h2>
          </div>
        </div>

        <div class="post-image-wrap">
          <a href="/post/read?slug=${post.slug}">
            <img src="${post.featuredImage || 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1200&q=80'}" alt="${post.title}" loading="lazy" />
          </a>
        </div>

        <p class="post-excerpt">${post.excerpt || post.content || ''}</p>

        <div class="post-footer">
          <a href="/post/read?slug=${post.slug}" class="read-more">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Read more
          </a>
          <span class="comments-count">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
            ${post.commentsCount || 0} Comments
          </span>
        </div>
      </article>
    `;
  }

  function cleanPosts(posts: any[]): any[] {
    return (posts || []).filter(
      (p: any) => p && p.title && p.slug !== 'tourist-destination-visit-vacation-india' && p.slug !== 'tours-visiting-classic-cars-charming-unique'
    );
  }

  function sortByDateDesc(posts: any[]): any[] {
    return [...posts].sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')));
  }

  function mergePosts(cloud: any[], local: any[], ssr: any[]): any[] {
    const map = new Map();
    for (const list of [cloud, local, ssr]) {
      if (!Array.isArray(list)) continue;
      for (const p of list) {
        if (p && p.id && !map.has(p.id)) map.set(p.id, p);
      }
    }
    return Array.from(map.values());
  }

  const feedContainer = document.getElementById('postsFeedContainer');

  function renderFeed(posts: any[]) {
    if (!feedContainer) return;
    const clean = cleanPosts(posts);
    if (clean.length > 0) {
      feedContainer.innerHTML = clean.map((post: any) => postCardHTML(post)).join('');
    } else {
      feedContainer.innerHTML = '<div style="padding: 40px 0; text-align: center;"><p>No blog posts published yet.</p></div>';
    }
  }

  async function initFeed() {
    if (!feedContainer) return;

    let ssrPosts = [];
    const ssrEl = document.getElementById('ssrPosts');
    if (ssrEl) {
      try { ssrPosts = JSON.parse(ssrEl.textContent || '[]'); } catch (e) {}
    }

    let localPosts = [];
    const stored = localStorage.getItem('tka_posts');
    if (stored) {
      try { localPosts = JSON.parse(stored); } catch (e) {}
    }

    // Paint instantly from cached posts so no stale server content flashes.
    if (localPosts.length > 0) {
      renderFeed(sortByDateDesc(localPosts));
    }

    // Sync from the KV-backed cloud database (authoritative, newest first).
    let cloudPosts = [];
    try {
      const res = await fetch('/api/posts');
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.posts)) cloudPosts = data.posts;
      }
    } catch (err) {}

    const allPosts = mergePosts(cloudPosts, localPosts, ssrPosts);
    localStorage.setItem('tka_posts', JSON.stringify(allPosts));
    renderFeed(sortByDateDesc(allPosts));
  }

  initFeed();
</script>
