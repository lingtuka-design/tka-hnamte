---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPosts, getSiteData } from '../lib/data';

const posts = await getPosts();
const site = await getSiteData();
---

<BaseLayout title={`${site.title} - ${site.tagline}`} description={site.bio}>
  <div class="main-layout">
    <section class="posts-feed" id="postsFeedContainer">
      <div id="feedLoading" style="padding: 60px 0; text-align: center; color: var(--text-muted);">
        <p>Loading posts...</p>
      </div>
    </section>

    <Sidebar />
  </div>

  <script type="application/json" id="ssrPosts" is:inline set:html={JSON.stringify(posts)}></script>
</BaseLayout>

<script>
  function stripHtml(html: any): string {
    if (!html) return '';
    const d = document.createElement('div');
    d.innerHTML = String(html).replace(/<script[\s\S]*?<\/script>/gi, '');
    return d.textContent || '';
  }

  // ---- Virtual list: only the cards near the viewport exist in the DOM. ----
  function createVirtualFeed(container: HTMLElement, buildCard: (post: any) => string) {
    const spacer = document.createElement('div');
    spacer.style.position = 'relative';
    spacer.style.width = '100%';
    const windowEl = document.createElement('div');
    windowEl.style.position = 'absolute';
    windowEl.style.top = '0';
    windowEl.style.left = '0';
    windowEl.style.right = '0';
    windowEl.style.willChange = 'transform';
    windowEl.style.display = 'flex';
    windowEl.style.flexDirection = 'column';
    windowEl.style.gap = '45px';
    spacer.appendChild(windowEl);
    container.appendChild(spacer);

    let items: any[] = [];
    let heights: number[] = [];
    let offsets: number[] = [];
    let estimate = 520;
    let start = 0;
    let end = -1;
    let rafPending = false;
    const OVERSCAN = 5;

    function computeOffsets() {
      offsets.length = items.length + 1;
      offsets[0] = 0;
      for (let i = 0; i < items.length; i++) {
        offsets[i + 1] = offsets[i] + (heights[i] || estimate);
      }
    }

    function findStart(scrollTop: number) {
      let lo = 0;
      let hi = items.length;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        if (offsets[mid] <= scrollTop) lo = mid;
        else hi = mid - 1;
      }
      return lo;
    }

    function measure() {
      const cards = windowEl.children;
      const n = cards.length;
      let changed = false;
      for (let i = 0; i < n; i++) {
        const idx = start + i;
        const h = i + 1 < n ? (cards[i + 1] as HTMLElement).offsetTop - (cards[i] as HTMLElement).offsetTop : (cards[i] as HTMLElement).offsetHeight;
        if (Math.abs((heights[idx] || estimate) - h) > 1) {
          heights[idx] = h;
          changed = true;
        }
      }
      if (changed) {
        computeOffsets();
        spacer.style.height = offsets[items.length] + 'px';
        const avg = items.length ? offsets[items.length] / items.length : estimate;
        estimate = Math.round(avg);
      }
    }

    function render(force: boolean) {
      if (!items.length) return;
      const viewH = window.innerHeight || 0;
      const scrollTop = window.scrollY || 0;
      let s = findStart(scrollTop);
      s = Math.max(0, s - OVERSCAN);
      let e = s;
      let acc = 0;
      while (e < items.length && (acc < viewH + OVERSCAN * estimate || e - s < OVERSCAN * 2)) {
        acc += heights[e] || estimate;
        e++;
      }
      e = Math.min(items.length, e);
      if (!force && s === start && e === end) return;

      start = s;
      end = e;
      let html = '';
      for (let i = s; i < e; i++) html += buildCard(items[i]);
      windowEl.innerHTML = html;
      windowEl.style.transform = 'translateY(' + (offsets[s] || 0) + 'px)';
      measure();
      windowEl.style.transform = 'translateY(' + (offsets[s] || 0) + 'px)';
    }

    function onScroll() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        rafPending = false;
        render(false);
      });
    }

    function onResize() {
      render(true);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);

    function setItems(next: any[]) {
      const prevLen = items.length;
      items = next;
      if (next.length !== prevLen) {
        heights = [];
        heights.length = next.length;
      }
      computeOffsets();
      spacer.style.height = offsets[items.length] + 'px';
      const maxScroll = Math.max(0, offsets[items.length] - (window.innerHeight || 0));
      if ((window.scrollY || 0) > maxScroll + 1) window.scrollTo(0, maxScroll);
      start = 0;
      end = -1;
      render(true);
    }

    render(true);

    return { setItems };
  }


  function postCardHTML(post: any) {
    return `
      <article class="post-card">
        <div class="post-header">
          <div class="date-badge">
            <span class="day">${post.day || '01'}</span>
            <span class="month">${post.month || 'Aug'}</span>
          </div>
          <div class="post-title-link">
            <h2 class="post-title">
              <a href="/post/read?slug=${post.slug}">${post.title}</a>
            </h2>
          </div>
        </div>

        <div class="post-image-wrap">
          <a href="/post/read?slug=${post.slug}">
            <img src="${post.featuredImage || 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1200&q=80'}" alt="${post.title}" loading="lazy" />
          </a>
        </div>

        <p class="post-excerpt">${post.excerpt || stripHtml(post.content) || ''}</p>

        <div class="post-footer">
          <a href="/post/read?slug=${post.slug}" class="read-more">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Read more
          </a>
          <span class="comments-count">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
            ${post.commentsCount || 0} Comments
          </span>
        </div>
      </article>
    `;
  }

  function cleanPosts(posts: any[]): any[] {
    return (posts || []).filter(
      (p: any) => p && p.title && p.slug !== 'tourist-destination-visit-vacation-india' && p.slug !== 'tours-visiting-classic-cars-charming-unique'
    );
  }

  function sortByDateDesc(posts: any[]): any[] {
    return [...posts].sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')));
  }

  function mergePosts(cloud: any[], local: any[], ssr: any[]): any[] {
    const map = new Map();
    for (const list of [cloud, local, ssr]) {
      if (!Array.isArray(list)) continue;
      for (const p of list) {
        if (p && p.id && !map.has(p.id)) map.set(p.id, p);
      }
    }
    return Array.from(map.values());
  }

  const feedContainer = document.getElementById('postsFeedContainer');
  let feed: { setItems: (posts: any[]) => void } | null = null;

  function renderFeed(posts: any[]) {
    if (!feedContainer) return;
    const clean = cleanPosts(posts);
    const loadingEl = document.getElementById('feedLoading');
    if (clean.length > 0) {
      if (!feed) feed = createVirtualFeed(feedContainer, postCardHTML);
      feed.setItems(sortByDateDesc(clean));
      if (loadingEl) loadingEl.remove();
    } else {
      feedContainer.innerHTML = '<div style="padding: 40px 0; text-align: center;"><p>No blog posts published yet.</p></div>';
    }
  }

  async function initFeed() {
    if (!feedContainer) return;

    let ssrPosts = [];
    const ssrEl = document.getElementById('ssrPosts');
    if (ssrEl) {
      try { ssrPosts = JSON.parse(ssrEl.textContent || '[]'); } catch (e) {}
    }

    let localPosts = [];
    const stored = localStorage.getItem('tka_posts');
    if (stored) {
      try { localPosts = JSON.parse(stored); } catch (e) {}
    }

    // Paint instantly from cached posts so no stale server content flashes.
    if (localPosts.length > 0) {
      renderFeed(sortByDateDesc(localPosts));
    }

    // Sync from the KV-backed cloud database (authoritative, newest first).
    let cloudPosts = [];
    try {
      const res = await fetch('/api/posts', { cache: 'no-store' });
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data.posts)) cloudPosts = data.posts;
      }
    } catch (err) {}

    const allPosts = mergePosts(cloudPosts, localPosts, ssrPosts);
    localStorage.setItem('tka_posts', JSON.stringify(allPosts));
    renderFeed(sortByDateDesc(allPosts));
  }

  initFeed();
</script>
