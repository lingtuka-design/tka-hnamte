---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sessionCookie = Astro.cookies.get('admin_session')?.value;
if (sessionCookie === 'authenticated_token_admin_777') {
  return Astro.redirect('/admin');
}
---

<BaseLayout title="Admin Login - ṬKA Hnamte Blog">
  <div class="admin-container" style="max-width: 440px;">
    <div class="admin-card">
      <h1 style="font-size: 1.5rem; text-align: center; margin-bottom: 8px; color: var(--text-heading);">
        Admin Portal
      </h1>
      <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 24px;">
        Single Admin Login to manage blog content
      </p>

      <form id="loginForm">
        <div class="admin-form-group">
          <label for="username">Username</label>
          <input type="text" id="username" class="admin-input" placeholder="Enter admin username" required autocomplete="off" />
        </div>

        <div class="admin-form-group">
          <label for="password">Password</label>
          <input type="password" id="password" class="admin-input" placeholder="Enter admin password" required autocomplete="off" />
        </div>

        <div id="errorAlert" style="display: none; background-color: #fee2e2; color: #b91c1c; padding: 10px; border-radius: 4px; font-size: 0.85rem; margin-bottom: 15px;">
        </div>

        <button type="submit" class="admin-btn" style="width: 100%;">
          Sign In to Admin
        </button>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('loginForm') as HTMLFormElement;
    const errorAlert = document.getElementById('errorAlert') as HTMLDivElement;

    if (localStorage.getItem('admin_logged_in') === 'true' || document.cookie.includes('admin_session=')) {
      window.location.href = '/admin/';
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.style.display = 'none';

      const username = (document.getElementById('username') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value.trim();

      if (username === 'admin' && password === 'adminpassword123') {
        document.cookie = 'admin_session=authenticated_token_admin_777; path=/; max-age=604800; Secure; SameSite=Lax';
        localStorage.setItem('admin_logged_in', 'true');
        localStorage.setItem('tka_admin_token', 'authenticated_token_admin_777');
        window.location.href = '/admin/';
        return;
      }

      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          document.cookie = 'admin_session=authenticated_token_admin_777; path=/; max-age=604800; Secure; SameSite=Lax';
          localStorage.setItem('admin_logged_in', 'true');
          localStorage.setItem('tka_admin_token', 'authenticated_token_admin_777');
          window.location.href = '/admin/';
        } else {
          errorAlert.textContent = data.message || 'Invalid username or password';
          errorAlert.style.display = 'block';
        }
      } catch (err) {
        errorAlert.textContent = 'Invalid credentials or connection error';
        errorAlert.style.display = 'block';
      }
    });
  </script>
</BaseLayout>
