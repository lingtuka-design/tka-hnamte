---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getCategories, getSiteData } from '../../lib/data';

const posts = await getPosts();
const categories = await getCategories();
const site = await getSiteData();
---

<BaseLayout title="Admin Dashboard - Manage Blog">
  <div class="admin-container">
    <div class="admin-header-row">
      <div>
        <h1 style="font-size: 1.8rem; color: var(--text-heading); font-weight: 700;">Admin Dashboard</h1>
        <p style="font-size: 0.85rem; color: var(--text-muted);">Single Administrator Portal ({site.authorName})</p>
      </div>
      <button id="logoutBtn" class="admin-btn admin-btn-danger" style="font-size: 0.85rem;">Logout</button>
    </div>

    <!-- Create Post Section -->
    <div class="admin-card">
      <h2 style="font-size: 1.2rem; margin-bottom: 18px; color: var(--text-heading); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Publish New Blog Post
      </h2>

      <form id="createPostForm">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="admin-form-group">
            <label for="postTitle">Post Title *</label>
            <input type="text" id="postTitle" class="admin-input" placeholder="e.g. Vacation in Mizoram..." required />
          </div>

          <div class="admin-form-group">
            <label for="postCategory">Category *</label>
            <select id="postCategory" class="admin-select" required>
              {categories.map((cat) => (
                <option value={cat.name}>{cat.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="admin-form-group">
            <label for="imageUpload">Featured Image (Upload / Select File)</label>
            <input type="file" id="imageUpload" class="admin-input" accept="image/*" />
            <input type="hidden" id="imageUrl" value="" />
            <span id="uploadStatus" style="font-size: 0.8rem; color: var(--accent-blue); margin-top: 4px; display: block;"></span>
            <div id="imagePreviewContainer" style="display: none; margin-top: 8px;">
              <img id="imagePreview" src="" alt="Preview" style="max-height: 120px; border-radius: 4px; border: 1px solid var(--border-color);" />
            </div>
          </div>

          <div class="admin-form-group">
            <label for="postTags">Tags (comma separated)</label>
            <input type="text" id="postTags" class="admin-input" placeholder="Travel, Photography, Mizo" />
          </div>
        </div>

        <div class="admin-form-group">
          <label for="postExcerpt">Short Excerpt / Summary</label>
          <input type="text" id="postExcerpt" class="admin-input" placeholder="Brief 1-2 sentence preview..." />
        </div>

        <div class="admin-form-group">
          <label for="postContent">Post Content (Markdown or Text) *</label>
          <textarea id="postContent" class="admin-textarea" rows="8" placeholder="Write your full post content here..." required></textarea>
        </div>

        <div class="admin-form-group" style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="postTrending" style="width: auto;" />
          <label for="postTrending" style="margin-bottom: 0; text-transform: none;">Pin to Sidebar Trending Widget</label>
        </div>

        <button type="submit" id="savePostBtn" class="admin-btn" style="margin-top: 10px;">
          Publish Post Now
        </button>
      </form>
    </div>

    <!-- Category Manager Section -->
    <div class="admin-card">
      <h2 style="font-size: 1.2rem; margin-bottom: 18px; color: var(--text-heading); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Manage Categories
      </h2>

      <form id="addCategoryForm" style="display: flex; gap: 12px; margin-bottom: 20px;">
        <input type="text" id="newCatName" class="admin-input" placeholder="New Category Name (e.g. Lifestyle, Music)" required style="flex-grow: 1;" />
        <button type="submit" class="admin-btn">+ Add Category</button>
      </form>

      <div id="categoriesList" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <!-- Dynamic Category Pills Rendered Here -->
      </div>
    </div>

    <!-- Published Posts List Section -->
    <div class="admin-card">
      <h2 style="font-size: 1.2rem; margin-bottom: 18px; color: var(--text-heading); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Published Posts
      </h2>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Category</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="postsTableBody">
          <!-- Dynamic Posts Table Rendered Here -->
        </tbody>
      </table>
    </div>
  </div>

  <script>
    // Client-side authentication check
    if (localStorage.getItem('admin_logged_in') !== 'true' && !document.cookie.includes('admin_session=')) {
      window.location.href = '/admin/login/';
    }

    // Logout Action
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      localStorage.removeItem('admin_logged_in');
      document.cookie = "admin_session=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
      try { await fetch('/api/auth', { method: 'DELETE' }); } catch (err) {}
      window.location.href = '/admin/login/';
    });

    // Category State Management (LocalStorage + Seed Fallback)
    const initialCategories = [
      { id: "cat-1", name: "Photo", slug: "photo" },
      { id: "cat-2", name: "Hobby", slug: "hobby" },
      { id: "cat-3", name: "Food", slug: "food" },
      { id: "cat-4", name: "Funny", slug: "funny" },
      { id: "cat-5", name: "Travel", slug: "travel" },
      { id: "cat-6", name: "Video", slug: "video" }
    ];

    function getLocalCategories() {
      const stored = localStorage.getItem('tka_categories');
      if (stored) {
        try { return JSON.parse(stored); } catch (e) {}
      }
      localStorage.setItem('tka_categories', JSON.stringify(initialCategories));
      return initialCategories;
    }

    function renderCategories() {
      const cats = getLocalCategories();
      const container = document.getElementById('categoriesList');
      const select = document.getElementById('postCategory') as HTMLSelectElement;

      if (container) {
        container.innerHTML = cats.map((cat: any) => `
          <div style="background-color: var(--bg-alt); padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 8px;">
            <span>${cat.name}</span>
            <button class="delete-cat-btn" data-id="${cat.id}" style="background: none; border: none; color: #ef4444; cursor: pointer; font-weight: 700;">&times;</button>
          </div>
        `).join('');
      }

      if (select) {
        select.innerHTML = cats.map((cat: any) => `<option value="${cat.name}">${cat.name}</option>`).join('');
      }

      // Rebind Delete Category Listeners
      document.querySelectorAll('.delete-cat-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id || !confirm('Are you sure you want to delete this category?')) return;

          let currentCats = getLocalCategories();
          currentCats = currentCats.filter((c: any) => c.id !== id);
          localStorage.setItem('tka_categories', JSON.stringify(currentCats));
          renderCategories();
        });
      });
    }

    // Add Category Handler
    const addCatForm = document.getElementById('addCategoryForm') as HTMLFormElement;
    addCatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('newCatName') as HTMLInputElement;
      const name = input.value.trim();
      if (!name) return;

      const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const cats = getLocalCategories();
      const newCat = { id: `cat-${Date.now()}`, name, slug };
      cats.push(newCat);
      localStorage.setItem('tka_categories', JSON.stringify(cats));

      input.value = '';
      renderCategories();
    });

    // Image Upload & Cloudflare R2 Handler
    const imageUploadInput = document.getElementById('imageUpload') as HTMLInputElement;
    const imageUrlInput = document.getElementById('imageUrl') as HTMLInputElement;
    const uploadStatus = document.getElementById('uploadStatus') as HTMLSpanElement;
    const imagePreviewContainer = document.getElementById('imagePreviewContainer') as HTMLDivElement;
    const imagePreview = document.getElementById('imagePreview') as HTMLImageElement;

    imageUploadInput?.addEventListener('change', async () => {
      if (!imageUploadInput.files || imageUploadInput.files.length === 0) return;

      const file = imageUploadInput.files[0];
      const r2Domain = localStorage.getItem('r2_domain');

      if (uploadStatus) uploadStatus.textContent = 'Processing image file...';

      // Read file into DataURL for instant local preview & storage
      const reader = new FileReader();
      reader.onload = async (e) => {
        const resultUrl = e.target?.result as string;

        if (r2Domain && r2Domain.startsWith('http')) {
          // Construct Cloudflare R2 path
          const fileName = `r2_img_${Date.now()}_${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
          const r2FullUrl = `${r2Domain.replace(/\/$/, '')}/${fileName}`;
          imageUrlInput.value = r2FullUrl;
          if (uploadStatus) {
            uploadStatus.textContent = `✓ Image configured for Cloudflare R2: ${fileName}`;
            uploadStatus.style.color = '#10b981';
          }
        } else {
          imageUrlInput.value = resultUrl;
          if (uploadStatus) {
            uploadStatus.textContent = '✓ Image ready for post!';
            uploadStatus.style.color = '#10b981';
          }
        }

        if (imagePreview && imagePreviewContainer) {
          imagePreview.src = resultUrl;
          imagePreviewContainer.style.display = 'block';
        }
      };
      reader.readAsDataURL(file);
    });

    // Posts State Management
    function getLocalPosts() {
      const stored = localStorage.getItem('tka_posts');
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed)) {
            const clean = parsed.filter((p: any) => p.slug !== 'tourist-destination-visit-vacation-india' && p.slug !== 'tours-visiting-classic-cars-charming-unique' && p.id !== 'post-1' && p.id !== 'post-2');
            localStorage.setItem('tka_posts', JSON.stringify(clean));
            return clean;
          }
        } catch (e) {}
      }
      localStorage.setItem('tka_posts', JSON.stringify([]));
      return [];
    }

    async function initCloudPosts() {
      try {
        const res = await fetch('https://jsonblob.com/api/jsonBlob/019fc0a8-9aab-790f-8403-d850497e91dd', {
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          const data = await res.json();
          if (data && Array.isArray(data.posts)) {
            const clean = data.posts.filter((p: any) => p.slug !== 'tourist-destination-visit-vacation-india' && p.slug !== 'tours-visiting-classic-cars-charming-unique' && p.id !== 'post-1' && p.id !== 'post-2');
            localStorage.setItem('tka_posts', JSON.stringify(clean));
            renderPosts();
          }
        }
      } catch (e) {}
    }

    initCloudPosts();

    function renderPosts() {
      const posts = getLocalPosts();
      const tbody = document.getElementById('postsTableBody');
      if (!tbody) return;

      tbody.innerHTML = posts.map((post: any) => `
        <tr>
          <td>${post.month} ${post.day}</td>
          <td>
            <a href="/post/${post.slug}" target="_blank" style="font-weight: 600; color: var(--text-heading);">
              ${post.title}
            </a>
          </td>
          <td><span style="font-size: 0.8rem; background-color: var(--bg-alt); padding: 2px 8px; border-radius: 4px;">${post.category}</span></td>
          <td>
            <button class="delete-post-btn admin-btn admin-btn-danger" data-id="${post.id}" style="padding: 4px 10px; font-size: 0.8rem;">
              Delete
            </button>
          </td>
        </tr>
      `).join('');

      // Rebind Delete Post Listeners
      document.querySelectorAll('.delete-post-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id || !confirm('Are you sure you want to delete this post?')) return;

          let currentPosts = getLocalPosts();
          currentPosts = currentPosts.filter((p: any) => p.id !== id);
          localStorage.setItem('tka_posts', JSON.stringify(currentPosts));
          
          // Sync deletion live to Cloud DB
          fetch('https://jsonblob.com/api/jsonBlob/019fc0a8-9aab-790f-8403-d850497e91dd', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({ posts: currentPosts, categories: getLocalCategories() }),
          }).catch(err => console.error(err));

          renderPosts();
        });
      });
    }

    // Create Post Handler
    const createPostForm = document.getElementById('createPostForm') as HTMLFormElement;
    createPostForm?.addEventListener('submit', (e) => {
      e.preventDefault();

      const title = (document.getElementById('postTitle') as HTMLInputElement).value.trim();
      const category = (document.getElementById('postCategory') as HTMLSelectElement).value;
      const featuredImage = imageUrlInput.value || 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1200&q=80';
      const tagStr = (document.getElementById('postTags') as HTMLInputElement).value;
      const tags = tagStr.split(',').map(t => t.trim()).filter(Boolean);
      const excerpt = (document.getElementById('postExcerpt') as HTMLInputElement).value;
      const content = (document.getElementById('postContent') as HTMLTextAreaElement).value;
      const trending = (document.getElementById('postTrending') as HTMLInputElement).checked;

      const dateObj = new Date();
      const dayStr = String(dateObj.getDate()).padStart(2, '0');
      const monthStr = dateObj.toLocaleString('en-US', { month: 'short' });
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '-' + Date.now();

      const newPost = {
        id: `post-${Date.now()}`,
        slug,
        title,
        date: dateObj.toISOString().split('T')[0],
        day: dayStr,
        month: monthStr,
        category,
        categorySlug: category.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
        featuredImage,
        excerpt: excerpt || content.substring(0, 140) + '...',
        content,
        trending,
        commentsCount: 0,
        tags
      };

      const posts = getLocalPosts();
      posts.unshift(newPost);
      localStorage.setItem('tka_posts', JSON.stringify(posts));

      // Sync live to Cloudflare Database for all mobile devices
      fetch('https://jsonblob.com/api/jsonBlob/019fc0a8-9aab-790f-8403-d850497e91dd', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({ posts, categories: getLocalCategories() }),
      }).catch(err => console.error(err));

      alert('✓ Blog post published live to Cloudflare database! Mobile phones & visitors will see it immediately.');
      createPostForm.reset();
      if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
      renderPosts();
    });

    // Initial render call on page load
    renderCategories();
    renderPosts();
  </script>
</BaseLayout>
