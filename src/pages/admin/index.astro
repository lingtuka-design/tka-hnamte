---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getCategories, getSiteData } from '../../lib/data';

const posts = await getPosts();
const categories = await getCategories();
const site = await getSiteData();
---

<BaseLayout title="Admin Dashboard - Manage Blog">
  <div class="admin-container">
    <div class="admin-header-row">
      <div>
        <h1 style="font-size: 1.8rem; color: var(--text-heading); font-weight: 700;">Admin Dashboard</h1>
        <p style="font-size: 0.85rem; color: var(--text-muted);">Single Administrator Portal ({site.authorName})</p>
      </div>
      <button id="logoutBtn" class="admin-btn admin-btn-danger" style="font-size: 0.85rem;">Logout</button>
    </div>

    <!-- Create / Edit Post Section -->
    <div class="admin-card">
      <h2 style="font-size: 1.2rem; margin-bottom: 18px; color: var(--text-heading); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Publish / Edit Blog Post
      </h2>

      <form id="createPostForm">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="admin-form-group">
            <label for="postTitle">Post Title *</label>
            <input type="text" id="postTitle" class="admin-input" placeholder="e.g. Vacation in Mizoram..." required />
          </div>

          <div class="admin-form-group">
            <label for="postCategory">Category *</label>
            <select id="postCategory" class="admin-select" required>
              {categories.map((cat) => (
                <option value={cat.name}>{cat.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="admin-form-group">
            <label for="imageUpload">Featured Image (Upload / Select File)</label>
            <input type="file" id="imageUpload" class="admin-input" accept="image/*" />
            <input type="hidden" id="imageUrl" value="" />
            <span id="uploadStatus" style="font-size: 0.8rem; color: var(--accent-blue); margin-top: 4px; display: block;"></span>
            <div id="imagePreviewContainer" style="display: none; margin-top: 8px;">
              <img id="imagePreview" src="" alt="Preview" style="max-height: 120px; border-radius: 4px; border: 1px solid var(--border-color);" />
            </div>
          </div>

          <div class="admin-form-group">
            <label for="postTags">Tags (comma separated)</label>
            <input type="text" id="postTags" class="admin-input" placeholder="Travel, Photography, Mizo" />
          </div>
        </div>

        <div class="admin-form-group">
          <label for="postExcerpt">Short Excerpt / Summary</label>
          <input type="text" id="postExcerpt" class="admin-input" placeholder="Brief 1-2 sentence preview..." />
        </div>

        <div class="admin-form-group">
          <label for="postContentEditor">Post Content *</label>
          <div class="rte-toolbar" id="rteToolbar">
            <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
            <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
            <button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
            <button type="button" data-cmd="strikeThrough" title="Strikethrough"><s>S</s></button>
            <span class="rte-sep"></span>
            <button type="button" data-cmd="formatBlock" data-value="H2" title="Heading"><b>H2</b></button>
            <button type="button" data-cmd="formatBlock" data-value="H3" title="Subheading"><b>H3</b></button>
            <button type="button" data-cmd="formatBlock" data-value="P" title="Paragraph">P</button>
            <button type="button" data-cmd="formatBlock" data-value="blockquote" title="Quote">&quot;</button>
            <span class="rte-sep"></span>
            <button type="button" data-cmd="insertUnorderedList" title="Bullet List">List</button>
            <button type="button" data-cmd="insertOrderedList" title="Numbered List">1. List</button>
            <span class="rte-sep"></span>
            <button type="button" data-cmd="createLink" title="Insert Link">Link</button>
            <button type="button" id="rteImageBtn" title="Insert Image from URL">Image</button>
            <button type="button" id="rteImageFileBtn" title="Upload Image">Upload</button>
            <span class="rte-sep"></span>
            <button type="button" data-cmd="removeFormat" title="Clear Formatting">Clear</button>
          </div>
          <div id="postContentEditor" class="rte-editor" contenteditable="true" data-placeholder="Write your post here..."></div>
          <input type="file" id="rteImageFile" accept="image/*" style="display:none;" />
        </div>

        <div class="admin-form-group" style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="postTrending" style="width: auto;" />
          <label for="postTrending" style="margin-bottom: 0; text-transform: none;">Pin to Sidebar Trending Widget</label>
        </div>

        <div style="display: flex; align-items: center; gap: 10px; margin-top: 10px;">
          <button type="submit" id="savePostBtn" class="admin-btn">
            Publish Post Now
          </button>
          <button type="button" id="cancelEditBtn" class="admin-btn admin-btn-danger" style="display: none;">
            Cancel Edit
          </button>
          <span id="editingIndicator" style="display: none; font-size: 0.85rem; color: var(--accent-blue); font-weight: 700;"></span>
        </div>
      </form>
    </div>

    <!-- Category Manager Section -->
    <div class="admin-card">
      <h2 style="font-size: 1.2rem; margin-bottom: 18px; color: var(--text-heading); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Manage Categories
      </h2>

      <form id="addCategoryForm" style="display: flex; gap: 12px; margin-bottom: 20px;">
        <input type="text" id="newCatName" class="admin-input" placeholder="New Category Name (e.g. Lifestyle, Music)" required style="flex-grow: 1;" />
        <button type="submit" class="admin-btn">+ Add Category</button>
      </form>

      <div id="categoriesList" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <!-- Dynamic Category Pills Rendered Here -->
      </div>
    </div>

    <!-- Published Posts List Section -->
    <div class="admin-card">
      <h2 style="font-size: 1.2rem; margin-bottom: 18px; color: var(--text-heading); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Published Posts
      </h2>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Category</th>
            <th>Views</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="postsTableBody">
          <!-- Dynamic Posts Table Rendered Here -->
        </tbody>
      </table>
    </div>
  </div>

  <script>
    // Force a single reload if this page is a stale cached build, so every
    // admin always runs the latest save/auth code (fixes "can't publish"
    // on devices that cached an old admin page).
    const ADMIN_VERSION = 'v4';
    try {
      if (localStorage.getItem('tka_admin_version') !== ADMIN_VERSION) {
        localStorage.setItem('tka_admin_version', ADMIN_VERSION);
        location.reload();
      }
    } catch (e) {}

    // Client-side authentication check
    if (localStorage.getItem('admin_logged_in') !== 'true' && !document.cookie.includes('admin_session=')) {
      window.location.href = '/admin/login/';
    }

    // Admin token for authed API calls (works even when cookies are blocked).
    function adminHeaders(extra?: any) {
      return {
        'Content-Type': 'application/json',
        'x-admin-token': localStorage.getItem('tka_admin_token') || 'authenticated_token_admin_777',
        ...(extra || {}),
      };
    }

    // Logout Action
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      localStorage.removeItem('admin_logged_in');
      localStorage.removeItem('tka_admin_token');
      document.cookie = "admin_session=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
      try { await fetch('/api/auth', { method: 'DELETE' }); } catch (err) {}
      window.location.href = '/admin/login/';
    });

    // Category State Management (KV-backed, localStorage is just a cache)
    const DEFAULT_CATS = [{ id: "cat-1", name: "Article", slug: "article" }];
    let localCats: any[] | null = null;

    function getLocalCategories() {
      if (localCats) return localCats;
      const stored = localStorage.getItem('tka_categories');
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed) && parsed.length > 0) {
            localCats = parsed;
            return parsed;
          }
        } catch (e) {}
      }
      localCats = [...DEFAULT_CATS];
      localStorage.setItem('tka_categories', JSON.stringify(localCats));
      return localCats;
    }

    function saveLocalCats() {
      localStorage.setItem('tka_categories', JSON.stringify(localCats));
      renderCategories();
    }

    async function initCategories() {
      try {
        const res = await fetch('/api/categories');
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data.categories) && data.categories.length > 0) {
            localCats = data.categories;
            localStorage.setItem('tka_categories', JSON.stringify(localCats));
          }
        }
      } catch (e) {}
      renderCategories();
    }

    function renderCategories() {
      const cats = getLocalCategories();
      const container = document.getElementById('categoriesList');
      const select = document.getElementById('postCategory') as HTMLSelectElement;

      if (container) {
        container.innerHTML = cats.map((cat: any) => `
          <div style="background-color: var(--bg-alt); padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 8px;">
            <span>${cat.name}</span>
            <button class="delete-cat-btn" data-id="${cat.id}" style="background: none; border: none; color: #ef4444; cursor: pointer; font-weight: 700;">&times;</button>
          </div>
        `).join('');
      }

      if (select) {
        select.innerHTML = cats.map((cat: any) => `<option value="${cat.name}">${cat.name}</option>`).join('');
      }

      // Rebind Delete Category Listeners
      document.querySelectorAll('.delete-cat-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id || !confirm('Are you sure you want to delete this category?')) return;

          const deleted = getLocalCategories().find((c: any) => c.id === id);
          localCats = getLocalCategories().filter((c: any) => c.id !== id);
          saveLocalCats();

          if (deleted) {
            try {
              await fetch('/api/categories', {
                method: 'DELETE',
                headers: adminHeaders(),
                body: JSON.stringify({ id, adminToken: localStorage.getItem('tka_admin_token') || 'authenticated_token_admin_777' }),
              });
            } catch (err) {}
          }
        });
      });
    }

    // Add Category Handler
    const addCatForm = document.getElementById('addCategoryForm') as HTMLFormElement;
    addCatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('newCatName') as HTMLInputElement;
      const name = input.value.trim();
      if (!name) return;

      const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const cats = getLocalCategories();
      const newCat = { id: `cat-${Date.now()}`, name, slug };
      cats.push(newCat);
      input.value = '';
      saveLocalCats();

      try {
        await fetch('/api/categories', {
          method: 'POST',
          headers: adminHeaders(),
          body: JSON.stringify({ name, adminToken: localStorage.getItem('tka_admin_token') || 'authenticated_token_admin_777' }),
        });
      } catch (err) {}
    });

    initCategories();

    // Image Upload & Cloudflare R2 Handler
    const imageUploadInput = document.getElementById('imageUpload') as HTMLInputElement;
    const imageUrlInput = document.getElementById('imageUrl') as HTMLInputElement;
    const uploadStatus = document.getElementById('uploadStatus') as HTMLSpanElement;
    const imagePreviewContainer = document.getElementById('imagePreviewContainer') as HTMLDivElement;
    const imagePreview = document.getElementById('imagePreview') as HTMLImageElement;

    imageUploadInput?.addEventListener('change', async () => {
      if (!imageUploadInput.files || imageUploadInput.files.length === 0) return;

      const file = imageUploadInput.files[0];
      const r2Domain = localStorage.getItem('r2_domain');

      if (uploadStatus) uploadStatus.textContent = 'Processing image file...';

      // Read file into DataURL for instant local preview & storage
      const reader = new FileReader();
      reader.onload = async (e) => {
        const resultUrl = e.target?.result as string;

        if (r2Domain && r2Domain.startsWith('http')) {
          // Construct Cloudflare R2 path
          const fileName = `r2_img_${Date.now()}_${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
          const r2FullUrl = `${r2Domain.replace(/\/$/, '')}/${fileName}`;
          imageUrlInput.value = r2FullUrl;
          if (uploadStatus) {
            uploadStatus.textContent = `✓ Image configured for Cloudflare R2: ${fileName}`;
            uploadStatus.style.color = '#10b981';
          }
        } else {
          imageUrlInput.value = resultUrl;
          if (uploadStatus) {
            uploadStatus.textContent = '✓ Image ready for post!';
            uploadStatus.style.color = '#10b981';
          }
        }

        if (imagePreview && imagePreviewContainer) {
          imagePreview.src = resultUrl;
          imagePreviewContainer.style.display = 'block';
        }
      };
      reader.readAsDataURL(file);
    });

    // Posts State Management
    function getLocalPosts() {
      const stored = localStorage.getItem('tka_posts');
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed)) {
            return parsed.filter((p: any) => p && p.title);
          }
        } catch (e) {}
      }
      return [];
    }

    function saveLocalPosts(posts: any[]) {
      localStorage.setItem('tka_posts', JSON.stringify(posts));
    }

    function syncLocalPosts(posts: any[]) {
      const map = new Map();
      for (const p of getLocalPosts()) { if (p && p.id) map.set(p.id, p); }
      for (const p of posts) { if (p && p.id) map.set(p.id, p); }
      saveLocalPosts(Array.from(map.values()));
    }

    // Load all published posts from the Cloudflare KV database on every load.
    async function loadCloudPosts() {
      try {
        const res = await fetch('/api/posts');
        if (!res.ok) return;
        const data = await res.json();
        if (Array.isArray(data.posts)) {
          syncLocalPosts(data.posts);
          renderPosts();
        }
      } catch (e) {
        console.error('Cloud DB Load Error:', e);
      }
    }

    function renderPosts() {
      const posts = getLocalPosts();
      const tbody = document.getElementById('postsTableBody');
      if (!tbody) return;

      tbody.innerHTML = posts.map((post: any) => `
        <tr>
          <td>${post.month || 'Aug'} ${post.day || '01'}</td>
          <td>
            <a href="/post/read?slug=${post.slug}" target="_blank" style="font-weight: 600; color: var(--text-heading);">
              ${post.title}
            </a>
          </td>
          <td><span style="font-size: 0.8rem; background-color: var(--bg-alt); padding: 2px 8px; border-radius: 4px;">${post.category || 'Article'}</span></td>
          <td>${post.views || 0}</td>
          <td style="white-space: nowrap;">
            <button class="edit-post-btn admin-btn" data-id="${post.id}" style="padding: 4px 10px; font-size: 0.8rem; margin-right: 6px;">
              Edit
            </button>
            <button class="delete-post-btn admin-btn admin-btn-danger" data-id="${post.id}" style="padding: 4px 10px; font-size: 0.8rem;">
              Delete
            </button>
          </td>
        </tr>
      `).join('');

      // Rebind Edit Post Listeners
      document.querySelectorAll('.edit-post-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id) return;
          const post = getLocalPosts().find((p: any) => p.id === id);
          if (post) startEditPost(post);
        });
      });

      // Rebind Delete Post Listeners
      document.querySelectorAll('.delete-post-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id || !confirm('Are you sure you want to delete this post?')) return;

          let currentPosts = getLocalPosts();
          currentPosts = currentPosts.filter((p: any) => p.id !== id);
          saveLocalPosts(currentPosts);
          renderPosts();

          // Persist deletion to the Cloudflare KV database
          try {
            await fetch('/api/posts', {
              method: 'DELETE',
              headers: adminHeaders(),
              body: JSON.stringify({ id, adminToken: localStorage.getItem('tka_admin_token') || 'authenticated_token_admin_777' })
            });
          } catch (err) {
            console.error('Cloud DB Delete Error:', err);
          }
        });
      });
    }

    // ---------- Rich Text Editor ----------
    const rteEditor = document.getElementById('postContentEditor') as HTMLElement;
    const rteToolbar = document.getElementById('rteToolbar');
    const rteImageFileInput = document.getElementById('rteImageFile') as HTMLInputElement;

    function execCmd(cmd: string, value?: string) {
      rteEditor?.focus();
      document.execCommand(cmd, false, value || null);
      updateRteButtons();
    }

    function updateRteButtons() {
      document.querySelectorAll('#rteToolbar button[data-cmd]').forEach((btn) => {
        const cmd = btn.getAttribute('data-cmd');
        btn.classList.toggle('is-active', cmd ? document.queryCommandState(cmd) : false);
      });
    }

    rteToolbar?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-cmd]') as HTMLButtonElement;
      if (!btn) return;
      const cmd = btn.getAttribute('data-cmd') || '';
      const value = btn.getAttribute('data-value') || '';

      if (cmd === 'createLink') {
        const url = prompt('Enter link URL:', 'https://');
        if (url) execCmd('createLink', url);
        return;
      }
      if (cmd === 'formatBlock') {
        execCmd('formatBlock', value === 'blockquote' ? '<blockquote>' : value);
        return;
      }
      execCmd(cmd, value || undefined);
    });

    rteEditor?.addEventListener('keyup', updateRteButtons);
    rteEditor?.addEventListener('mouseup', updateRteButtons);

    // Insert image into content from a URL
    document.getElementById('rteImageBtn')?.addEventListener('click', () => {
      const url = prompt('Enter image URL:');
      if (url) execCmd('insertImage', url);
    });

    // Upload an image from the device and insert it into the content
    document.getElementById('rteImageFileBtn')?.addEventListener('click', () => {
      rteImageFileInput?.click();
    });
    rteImageFileInput?.addEventListener('change', () => {
      if (!rteImageFileInput.files || rteImageFileInput.files.length === 0) return;
      const file = rteImageFileInput.files[0];
      const reader = new FileReader();
      reader.onload = (ev) => {
        const url = ev.target?.result as string;
        if (url) execCmd('insertImage', url);
        rteImageFileInput.value = '';
      };
      reader.readAsDataURL(file);
    });

    // ---------- Edit Post State ----------
    let editingPostId: string | null = null;

    function startEditPost(post: any) {
      editingPostId = post.id;

      (document.getElementById('postTitle') as HTMLInputElement).value = post.title || '';

      const catSelect = document.getElementById('postCategory') as HTMLSelectElement;
      if (post.category) {
        let opt = Array.from(catSelect.options).find(o => o.value === post.category);
        if (!opt) {
          opt = document.createElement('option');
          opt.value = post.category;
          opt.textContent = post.category;
          catSelect.appendChild(opt);
        }
        catSelect.value = post.category;
      }

      (document.getElementById('postTags') as HTMLInputElement).value = (post.tags || []).join(', ');
      (document.getElementById('postExcerpt') as HTMLInputElement).value = post.excerpt || '';
      (document.getElementById('postTrending') as HTMLInputElement).checked = !!post.trending;
      if (rteEditor) rteEditor.innerHTML = post.content || '';

      imageUrlInput.value = post.featuredImage || '';
      if (imagePreview && imagePreviewContainer) {
        imagePreview.src = post.featuredImage || '';
        imagePreviewContainer.style.display = post.featuredImage ? 'block' : 'none';
      }

      const saveBtn = document.getElementById('savePostBtn');
      const cancelBtn = document.getElementById('cancelEditBtn');
      const indicator = document.getElementById('editingIndicator');
      if (saveBtn) saveBtn.textContent = 'Update Post';
      if (cancelBtn) cancelBtn.style.display = 'inline-block';
      if (indicator) {
        indicator.textContent = `Editing: ${post.title}`;
        indicator.style.display = 'inline-block';
      }

      document.getElementById('createPostForm')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function resetPostForm() {
      editingPostId = null;
      (document.getElementById('createPostForm') as HTMLFormElement).reset();
      if (rteEditor) rteEditor.innerHTML = '';
      imageUrlInput.value = '';
      if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';

      const saveBtn = document.getElementById('savePostBtn');
      const cancelBtn = document.getElementById('cancelEditBtn');
      const indicator = document.getElementById('editingIndicator');
      if (saveBtn) saveBtn.textContent = 'Publish Post Now';
      if (cancelBtn) cancelBtn.style.display = 'none';
      if (indicator) indicator.style.display = 'none';
    }

    document.getElementById('cancelEditBtn')?.addEventListener('click', resetPostForm);

    // ---------- Save Post Handler (Create + Edit) ----------
    const createPostForm = document.getElementById('createPostForm') as HTMLFormElement;
    createPostForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const title = (document.getElementById('postTitle') as HTMLInputElement).value.trim();
      const category = (document.getElementById('postCategory') as HTMLSelectElement).value || 'Article';
      const featuredImage = imageUrlInput.value || 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1200&q=80';
      const tagStr = (document.getElementById('postTags') as HTMLInputElement).value;
      const tags = tagStr.split(',').map(t => t.trim()).filter(Boolean);
      const excerpt = (document.getElementById('postExcerpt') as HTMLInputElement).value;
      const content = rteEditor ? rteEditor.innerHTML : '';
      const plainText = rteEditor ? (rteEditor.innerText || '') : '';
      const trending = (document.getElementById('postTrending') as HTMLInputElement).checked;

      if (!title || !plainText.trim()) {
        alert('Post title and content are required.');
        return;
      }

      const existing = editingPostId ? getLocalPosts().find((p: any) => p.id === editingPostId) : null;
      const dateObj = new Date();
      const dayStr = String(dateObj.getDate()).padStart(2, '0');
      const monthStr = dateObj.toLocaleString('en-US', { month: 'short' });

      const postData = {
        id: existing ? existing.id : `post-${Date.now()}`,
        slug: existing ? existing.slug : title.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '-' + Date.now(),
        title,
        date: existing ? existing.date : dateObj.toISOString().split('T')[0],
        day: existing ? existing.day : dayStr,
        month: existing ? existing.month : monthStr,
        category,
        categorySlug: category.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
        featuredImage,
        excerpt: excerpt || plainText.substring(0, 140) + '...',
        content,
        trending,
        views: existing ? (existing.views || 0) : 0,
        commentsCount: existing ? (existing.commentsCount || 0) : 0,
        tags
      };

      const posts = getLocalPosts();
      const idx = posts.findIndex((p: any) => p.id === postData.id);
      if (idx >= 0) {
        posts[idx] = { ...posts[idx], ...postData };
      } else {
        posts.unshift(postData);
      }
      saveLocalPosts(posts);
      renderPosts();

      // Persist to the Cloudflare KV-backed serverless function /api/posts
      let cloudSaved = true;
      let cloudError = '';
      try {
        const res = await fetch('/api/posts', {
          method: 'POST',
          headers: adminHeaders(),
          body: JSON.stringify({ ...postData, adminToken: localStorage.getItem('tka_admin_token') || 'authenticated_token_admin_777' })
        });
        if (!res.ok) {
          cloudSaved = false;
          const errData = await res.json().catch(() => null);
          cloudError = (errData && errData.error) || ('HTTP ' + res.status);
          console.error('Cloud DB Save Error:', res.status, errData);
        }
      } catch (err) {
        cloudSaved = false;
        cloudError = String(err);
        console.error('Cloudflare Worker Post Error:', err);
      }

      alert(existing
        ? (cloudSaved ? '✓ Post updated successfully live to Cloudflare!' : `⚠ Post updated locally only — cloud save failed! (${cloudError})`)
        : (cloudSaved ? '✓ Post published successfully live to Cloudflare!' : `⚠ Post saved locally only — cloud publish failed! (${cloudError})`));
      resetPostForm();
      renderPosts();
    });

    // Initial render call on page load
    renderCategories();
    renderPosts();
    loadCloudPosts();
  </script>
</BaseLayout>
