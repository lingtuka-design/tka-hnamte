---
import { getCategories } from '../lib/data';

const categories = await getCategories();
const currentPath = Astro.url.pathname;
---

<nav class="nav-bar">
  <div class="nav-container">
    <ul class="nav-links">
      <li>
        <a href="/" class={`nav-item ${currentPath === '/' ? 'active' : ''}`}>HOME</a>
      </li>
      {categories.map((cat) => (
        <li>
          <a
            href={`/category/${cat.slug}`}
            class={`nav-item ${currentPath === `/category/${cat.slug}` ? 'active' : ''}`}
          >
            {cat.name.toUpperCase()}
          </a>
        </li>
      ))}
      <li>
        <a href="/admin" class="nav-item" style="color: var(--accent-blue);">ADMIN</a>
      </li>
    </ul>

    <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle dark mode">
      <span class="theme-icon">🌙</span>
      <span>Theme</span>
    </button>
  </div>
</nav>

<script>
  // Hydrate categories dynamically if modified in Admin
  const storedCats = localStorage.getItem('tka_categories');
  if (storedCats) {
    try {
      const cats = JSON.parse(storedCats);
      const navLinks = document.querySelector('.nav-links');
      if (navLinks && cats.length > 0) {
        const homeLi = navLinks.querySelector('li:first-child');
        const adminLi = navLinks.querySelector('li:last-child');
        const catLis = cats.map((cat: any) => `
          <li>
            <a href="/category/${cat.slug}" class="nav-item">${cat.name.toUpperCase()}</a>
          </li>
        `).join('');
        navLinks.innerHTML = `${homeLi?.outerHTML || ''}${catLis}${adminLi?.outerHTML || ''}`;
      }
    } catch (e) {}
  }
</script>
