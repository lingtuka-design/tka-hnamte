---
import { getCategories } from '../lib/data';

const categories = await getCategories();
const currentPath = Astro.url.pathname;
---

<nav class="nav-bar">
  <div class="nav-container">
    <ul class="nav-links">
      <li>
        <a href="/" class={`nav-item ${currentPath === '/' ? 'active' : ''}`}>HOME</a>
      </li>
      {categories.map((cat) => (
        <li>
          <a
            href={`/category/${cat.slug}`}
            class={`nav-item ${currentPath === `/category/${cat.slug}` ? 'active' : ''}`}
          >
            {cat.name.toUpperCase()}
          </a>
        </li>
      ))}
      <li>
        <a href="/admin" class="nav-item" style="color: var(--accent-blue);">ADMIN</a>
      </li>
    </ul>

    <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle dark mode">
      <span class="theme-icon">🌙</span>
      <span>Theme</span>
    </button>
  </div>
</nav>

<script>
  // Hydrate categories from the KV-backed API (authoritative). Also overwrites
  // any stale/seeded localStorage list so the menu always matches the real data.
  function renderNavCats(cats: any[]) {
    const navLinks = document.querySelector('.nav-links');
    if (!navLinks || !Array.isArray(cats) || cats.length === 0) return;
    const homeLi = navLinks.querySelector('li:first-child');
    const adminLi = navLinks.querySelector('li:last-child');
    const catLis = cats.map((cat: any) => `
      <li>
        <a href="/category/${cat.slug}" class="nav-item">${cat.name.toUpperCase()}</a>
      </li>
    `).join('');
    navLinks.innerHTML = `${homeLi?.outerHTML || ''}${catLis}${adminLi?.outerHTML || ''}`;
  }

  (async () => {
    try {
      const res = await fetch('/api/categories');
      if (res.ok) {
        const data = await res.json();
        const cats = Array.isArray(data.categories) ? data.categories : [];
        if (cats.length > 0) {
          localStorage.setItem('tka_categories', JSON.stringify(cats));
          renderNavCats(cats);
          return;
        }
      }
    } catch (e) {}

    // Fallback: only render a stored list if it actually exists (never seeded).
    try {
      const stored = localStorage.getItem('tka_categories');
      if (stored) {
        const cats = JSON.parse(stored);
        if (Array.isArray(cats) && cats.length > 0) renderNavCats(cats);
      }
    } catch (e) {}
  })();
</script>
